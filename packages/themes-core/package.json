{
  "name": "@progressiveui/themes-core",
  "description": "Themes for un core",
  "version": "0.5.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Polyxo/pui.git",
    "directory": "packages/themes-core"
  },
  "bugs": "https://github.com/Polyxo/pui/issues",
  "keywords": [
    "colors",
    "themes",
    "components",
    "react"
  ],
  "type": "module",
  "main": "config.js",
  "exports": {
    ".": "./config.js",
    "./config.js": "./config.js",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./distDark/*": "./distDark/*",
    "./tokens/*": "./tokens/*",
    "./tokensDark/*": "./tokensDark/*"
  },
  "files": [
    "config.js",
    "scripts/config.js",
    "dist",
    "distDark",
    "tokens",
    "tokensDark",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node --stack-size=9900 scripts/runTheme.js",
    "filter:theme": "node scripts/filterJson.js",
    "sync:tokens": "node scripts/syncTokens.js",
    "build:tokens": "yarn sync:tokens && yarn filter:theme && yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "axios": "^1.10.0",
    "dotenv": "^16.3.1"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "style-dictionary": "^3.9.2"
  },
  "gitHead": "7201da36cfb8dad97a91763abc2497f70c239243"
}
