{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "es2018",
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "typeRoots": [
    "./node_modules/@types",
    "./typings"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "components/PropTypes/index.js",
    ".next/types/**/*.ts",
    "components/Post/index.tsx.new",
    "tina/database.ts.new",
    "appnew/new/[...slug]/page.tsx.new",
    "lib/databaseConnection.ts.new",
    "pages/api/gql.ts.new",
    "app/layout.tsx",
    "app/opengraph/[[...slug]]/opengraph-image.tsx.new",
    "app/[[...slug]]/opengraph-image.tsx.f",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "*.sitemap.xml.tsx",
    "**/*.build.tsx"
  ]
}
