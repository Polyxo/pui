{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node", "mdx"]
  },
  "include": [".storybook/**/*", "src/**/*.stories.*", "src/indexStories.ts"],
  "exclude": ["dist", "docs", "node_modules", "othersrc"]
}
