{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    ".storybook",
    "dist",
    "docs",
    "node_modules",
    "othersrc",
    "src/indexStories.ts",
    "src/**/*.stories.*",
    "src/**/*.test.*",
    "src/**/*-test.*",
    "src/**/*.legacy.*",
    "src/**/*-old.*"
  ]
}
