{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "es6",
    "moduleResolution": "node",
    "outDir": "./dist",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["ES5", "ES2015", "ES2016", "DOM", "ESNext"],
    "types": ["node"],
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": false,
    "sourceMap": true,
    "strict": true,
    "target": "ES6"
  },
  "typeRoots": ["./node_modules/@types", "./typings"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "othersrc",
    "src/indexStories.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*-test.*",
    "src/**/*.stories.*",
    "src/**/*.legacy.*",
    "src/**/*-old.*"
  ]
}
