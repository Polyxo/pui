{
  "name": "@progressiveui/react",
  "version": "2.2.7",
  "description": "Progressive UI react components",
  "license": "Apache-2",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "build": "yarn build:vite",
    "clean": "rimraf es lib umd storybook-static build react-docgen.json",
    "build:rollup": "rollup -c --bundleConfigAsCjs",
    "build:demos": "rollup -c rollupDemos.config.js --bundleConfigAsCjs",
    "build:storybook": "node scripts/buildStorybook.mjs",
    "generate:website-metadata": "rollup --config scripts/rollup-generateTypeDefinitions.config.js --bundleConfigAsCjs && node .temp/generateTypeDefinitions.js && rm -rf .temp",
    "generate:types": "yarn generate:website-metadata",
    "dev": "npm run storybook",
    "storybook": "STORYBOOK_ASSETS=https://cdn.polyxo.de/guides/ui/assets/v0.0.1/ STORYBOOK_NPM_VERSION=10.10.3 storybook dev -p 9000",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "jest-w": "jest --watch",
    "build:vite": "vite build"
  },
  "sass": {
    "includePaths": [
      "./node_modules"
    ]
  },
  "keywords": [
    "progressiveui",
    "react",
    "ui-kit",
    "components"
  ],
  "files": [
    ".storybook",
    "config",
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "dependencies": {
    "@types/prop-types": "^15.7.11",
    "@progressiveui/icons-react": "^10.38.2",
    "classnames": "2.5.1",
    "prop-types": "^15.8.1",
    "react-popper-tooltip": "^4.4.2",
    "react-transition-state": "^2.3.1",
    "warning": "^4.0.3",
    "window-or-global": "^1.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/traverse": "^7.27.0",
    "@carbon/feature-flags": "^0.6.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/open-sans": "^5.2.5",
    "@mdx-js/react": "^3.1.1",
    "@progressiveui/styles": "^11.3.1",
    "@progressiveui/themes-core": "^0.5.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@storybook/addon-actions": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/mdx": "^2.0.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-dev-expression": "^0.2.3",
    "babel-plugin-named-exports-order": "^0.0.2",
    "browserslist-config-carbon": "^11.2.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^0.12.0",
    "handlebars": "^4.7.8",
    "invariant": "^2.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "object-assign": "^4.1.1",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-custom-properties": "^14.0.4",
    "prettier": "^3.5.3",
    "pretty": "^2.0.0",
    "prismjs": "^1.30.0",
    "promise": "^8.3.0",
    "react": "19.2.7",
    "react-dates": "^21.8.0",
    "react-datepicker": "^4.6.0",
    "react-docgen": "^7.1.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "19.2.7",
    "react-dropzone": "^14.3.8",
    "react-final-form": "^6.5.9",
    "react-hook-form": "^7.20.5",
    "react-markdown": "^9.0.0",
    "react-popper": "^2.2.3",
    "react-prism": "^4.3.2",
    "react-redux": "^7.2.1",
    "react-select": "^5.10.1",
    "react-table": "7.8.0",
    "recharts": "^2.15.2",
    "redux-form": "^8.3.10",
    "requestanimationframe": "^0.0.23",
    "rimraf": "^6.0.1",
    "rollup": "4.1.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "sass": "^1.98.0",
    "sass-loader": "16.0.7",
    "storybook": "^8.6.18",
    "ts-jest": "^29.4.11",
    "twig": "^1.17.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Polyxo/pui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundleSizeThreshold": 80000,
  "gitHead": "5a07fc0b14e9aee8ac1ce65c21b4275593fd4c0c"
}
