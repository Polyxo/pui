{
  "name": "@progressiveui/icons-core",
  "description": "Icon generation tools for Progressive UI",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Polyxo/pui.git",
    "directory": "packages/icons-core"
  },
  "bugs": "https://github.com/Polyxo/pui/issues",
  "main": "build/bundle.js",
  "module": "build/bundle.js",
  "types": "dist/bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bundle.d.ts",
      "import": "./build/bundle.js",
      "require": "./build/bundle.js",
      "default": "./build/bundle.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "build/bundle.js",
    "build/bundle.js.map",
    "dist/bundle.d.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "colors",
    "themes",
    "un",
    "un core",
    "components",
    "react"
  ],
  "scripts": {
    "legacy:build-babel": "babel -d ./build ./src -s",
    "legacy:watch": "babel -d ./build ./src -s --watch",
    "build:old": "yarn legacy:build-babel",
    "watch": "yarn legacy:watch",
    "_clear": "rimraf build/compiled/*",
    "_tsc": "tsc",
    "_make-bundle": "rollup --config",
    "build": "yarn _clear && yarn _tsc && yarn _make-bundle"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/cli": "^7.19.3",
    "@babel/node": "^7.20.2",
    "@babel/preset-env": "^7.29.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.28.5",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@svgr/core": "^7.0.0",
    "@svgr/plugin-jsx": "^7.0.0",
    "@svgr/plugin-prettier": "^7.0.0",
    "@svgr/plugin-svgo": "^7.0.0",
    "camelcase": "^6.3.0",
    "change-case": "^4.1.2",
    "del": "^6.1.1",
    "fs-extra": "^11.3.2",
    "fs-readdir-recursive": "^1.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "svgo": "^3.3.3"
  },
  "gitHead": "5d9678f4a62413b834d07736413c50ff2f851824"
}
